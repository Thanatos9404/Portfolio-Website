# Contact form delivery (set in Vercel > Project > Settings > Environment Variables).
# Preferred: Resend (https://resend.com). CONTACT_FROM must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM=Portfolio <contact@yashvardhan.tech>
CONTACT_TO=founder@llmslim.app

# Fallback when RESEND_API_KEY is empty. Defaults to the existing Formspree form.
FORMSPREE_FORM_ID=

# Optional: read-only GitHub token (no scopes) to raise API limits for /api/stats.
GITHUB_TOKEN=

# Local development only: log contact messages instead of sending them.
CONTACT_DRY_RUN=1
